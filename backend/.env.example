# Conexión a PostgreSQL (Neon, Supabase, Railway, etc.)
# Ej: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/el_bidon

# development | production
NODE_ENV=development
PORT=3001

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cualquier string largo y aleatorio (en producción Render lo genera solo)
JWT_SECRET=your_jwt_secret_here

# URL(s) del frontend permitidas (separar con coma para múltiples)
# Ej: https://el-bidon.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000
